+////////////////////////////////////////////////////////////////////////////////
+// write to global
+.macro WRITE_GLOBAL d0 d1
+.if 1
+.set idx, 64+\d1*8+\d0
+v_mov_b32 v12, s15                    // v12 = strideC1J
+v_mov_b32 v13, 0x0                    // v13 = 0
