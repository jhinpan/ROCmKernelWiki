+v_mov_b32 v13, 0x0                    // v13 = 0
+v_mul_u32_u24 v12, \d1, v12           // v12 = strideC1J*d1
+v_add_u32 v12, vcc, \d0, v12          // v12 = strideC1J*d1+d0
+v_lshlrev_b64 v[12:13], 6, v[12:13]   // v12 = 16*(strideC1J*d1+d0)*4
