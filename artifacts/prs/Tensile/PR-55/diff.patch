+// v[18:19]  LDS_read_addr    x2 A[0:7] B[0:7]
+// v[20:23]  Global_read_addr x4 Ax1 Bx1 each 8-byte
+// v[24:31]  G->L load regs   x8 Ax4 Bx4 no red/black
+// v[32:39]  A_red            x8
+// v[40:47]  B_red            x8
+// v[48:55]  A_black          x8
