+                                      //                                    0  0
+// prefetch before loop
+READ_GLOBAL                           // Load (a)                           2  2
+s_waitcnt vmcnt(0) & lgkmcnt(0)       // Wait (a)                           0  0
+WRITE_LOCAL                           // Stor [b]                           2  0
