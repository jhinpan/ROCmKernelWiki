+s_lshl_b32 s21, s15, 2                // strideC *= 4 bytes
+v_mul_lo_u32 v3, s21, v1              // v3  = l1J*strideC1J
+v_add_u32 v10, vcc, v3, v10           // v[10:11]=C*+off+wg_off+l1J*stride
