+
+v_add_u32  v16, vcc, v3, v16
+v_addc_u32 v17, vcc, v17, 0x0, vcc
+
+v_add_u32  v18, vcc, v3, v18
+v_addc_u32 v19, vcc, v19, 0x0, vcc
+
