+s_waitcnt vmcnt(0) & lgkmcnt(0)       // wait C
+v_mul_f32 v9, s11, v9                 // v9 = C*beta
+v_mul_f32 v[idx], s10, v[idx]         // v[i] *= alpha
+v_add_f32 v[idx], v9, v[idx]          // v[i] = sum*alpha + C*beta
