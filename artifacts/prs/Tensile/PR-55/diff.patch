+// iter count
+s_lshr_b32 s20, s20, 3                // s20=sizeK/8
+s_sub_i32 s20, 0x0, s20               // s20 = -sizeK/8
+s_add_u32 s20, s20, 1                 // extra iter w/o prefetch
