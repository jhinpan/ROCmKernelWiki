diff --git a/Tensile/Configs/test_sgemm_scalar_branches.yaml b/Tensile/Configs/test_sgemm_scalar_branches.yaml
new file mode 100644
index 000000000..54e90a630
--- /dev/null
+++ b/Tensile/Configs/test_sgemm_scalar_branches.yaml
@@ -0,0 +1,127 @@
+# test load patterns
+GlobalParameters:
+  NumElementsToValidate: -1
+  ValidationMaxToPrint: 4
+
+BenchmarkProblems:
+  # sgemm NT
+  - ProblemType:
+      OperationType: GEMM
+      DataType: s
+      TransposeA: False
+      TransposeB: True
+      UseBeta: False
+    BenchmarkCommonParameters:
+      - ProblemSizes: [ [8, 32, 0, 75], [8, 32, 0, 75], [63, 1, 64] ]
+      - LoopDoWhile: [False]
+      - LoopTail: [True]
+      - EdgeType: ["Branch"]
+      - LocalWriteCoalesceGroupA: [True]
+      - LocalWriteCoalesceGroupB: [True]
+      - GlobalReadCoalesceVectorA: [True]
+      - GlobalReadCoalesceVectorB: [True]
+      - NumLoadsCoalescedA: [1]
+      - NumLoadsCoalescedB: [1]
+      - DepthU: [ 16 ]
+      - VectorWidth: [1]
+    ForkParameters:
+      - GroupShape: [ 0, 2 ]
+      - NumThreads: [128, 256 ]
+      - ThreadTileShape: [0, 2]
+      - ThreadTileNumElements: [16, 32, 36]
+      - SplitU: [ 1, 2 ]
+    BenchmarkFinalParameters:
+      - ProblemSizes: [ [128, 128, 256], [128, 128, 256], [64] ]
+
+
+  # sgemm NN
+  - ProblemType:
+      OperationType: GEMM
+      DataType: s
+      TransposeA: False
+      TransposeB: False
+      UseBeta: True
+    BenchmarkCommonParameters:
+      - ProblemSizes: [ [8, 32, 0, 75], [8, 32, 0, 75], [63, 1, 64] ]
+      - LoopDoWhile: [False]
+      - LoopTail: [True]
+      - EdgeType: ["Branch"]
+      - LocalWriteCoalesceGroupA: [True]
+      - LocalWriteCoalesceGroupB: [True]
+      - GlobalReadCoalesceVectorA: [True]
+      - GlobalReadCoalesceVectorB: [True]
+      - NumLoadsCoalescedA: [1]
+      - NumLoadsCoalescedB: [1]
+      - DepthU: [ 16 ]
+      - VectorWidth: [1]
+    ForkParameters:
+      - GroupShape: [ 0, -2 ]
+      - NumThreads: [128, 256 ]
+      - ThreadTileShape: [0, -2]
+      - ThreadTileNumElements: [16, 32, 36]
+      - SplitU: [ 1, 2 ]
+    BenchmarkFinalParameters:
+      - ProblemSizes: [ [128, 128, 256], [128, 128, 256], [64] ]
+
+  # sgemm TN
+  - ProblemType:
+      OperationType: GEMM
+      DataType: s
+      TransposeA: True
+      TransposeB: False
+      UseBeta: True
+    BenchmarkCommonParameters:
+      - ProblemSizes: [ [8, 32, 0, 75], [8, 32, 0, 75], [63, 1, 64] ]
+      - LoopDoWhile: [False]
+      - LoopTail: [True]
+      - EdgeType: ["Branch"]
+      - LocalWriteCoalesceGroupA: [True]
+      - LocalWriteCoalesceGroupB: [True]
+      - GlobalReadCoalesceVectorA: [True]
+      - GlobalReadCoalesceVectorB: [True]
+      - NumLoadsCoalescedA: [1]
+      - NumLoadsCoalescedB: [-1]
+      - DepthU: [ 16 ]
+      - VectorWidth: [1]
+    ForkParameters:
+      - GroupShape: [ 0, -2 ]
+      - NumThreads: [128, 256 ]
