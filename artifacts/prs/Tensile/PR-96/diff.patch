+          - [2, 8]
+        - WorkGroup:
+          - [  8,  4, 4 ]
+          - [ 16, 16, 1 ]
+        - VectorWidth: [2, 4]
+      BenchmarkFinalParameters:
+        - ProblemSizes:
+          - Range: [ [8, 32, 0, 75], [8, 32, 0, 75], [3], [63, 1, 64] ]
+
+
+    ############################################################################
