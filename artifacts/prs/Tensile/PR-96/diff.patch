+GlobalParameters:
+  PrintLevel: 1
+  ForceRedoBenchmarkProblems: True
+  PrintSolutionRejectionReason: False
+  MinimumRequiredVersion: 3.0.0
+  NumElementsToValidate: -1
+  ValidationMaxToPrint: 4
+  DataInitTypeAB: 1
+  DataInitTypeC: 1
+
+BenchmarkProblems:
+
+    ############################################################################
+    # NN
+    ############################################################################
+  -
+    - # ProblemType
+      OperationType: GEMM
+      DataType: h
+      TransposeA: False
+      TransposeB: False
+      UseBeta: False
+      Batched: True
+
+    - # Tile Sizes
+      BenchmarkCommonParameters:
+        - EdgeType: ["ShiftPtr"]
+        - LoopTail: [True]
+        - MacroTileShapeMax: [64]
+      ForkParameters:
+        - ThreadTile:
+          - [8, 8]
+          - [7, 4]
+          - [3, 5]
+          - [2, 6]
+          - [1, 1]
+        - WorkGroup:
+          - [ 16, 16,  1 ]
+          - [  8,  2, 16 ]
+          - [ 16, 12,  1 ]
+        - DepthU: [ 2, 16, 64 ]
+        - GlobalSplitU: [1, 4]
+        - VectorWidth: [2, 4]
+      BenchmarkFinalParameters:
+        - ProblemSizes:
+          - Exact: [   1, 1, 1, 1 ]
+          - Range: [ [127, 1, 129], [127, 1, 129], [1, 2], [63, 1, 65] ]
+
+
+    - # Non-Tile Sizes
