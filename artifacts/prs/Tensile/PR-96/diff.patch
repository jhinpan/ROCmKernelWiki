+        - EdgeType: ["ShiftPtr"]
+        - LoopTail: [True]
+        - WorkGroup: [ [8, 8, 2 ] ]
+        - ThreadTile: [ [4, 8] ]
+        - DepthU: [ 16 ]
+        - NumLoadsCoalescedA: [-1]
+        - NumLoadsCoalescedB: [-1]
