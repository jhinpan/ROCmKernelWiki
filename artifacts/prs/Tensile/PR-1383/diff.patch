+from copy import copy
+class Backup:
+  """RAII class to restore backed up fields from object"""
+  fields = {}
+  object = None
+  def __init__(self, object, **fields):
+    self.object = object
+    for k, v in fields.items():
+        self.fields[k] = copy(v)
+  def __del__(self):
+    for k, v in self.fields.items():
+        setattr(self.object, k, v)
