index 2de4e0db2..85b2ba8bf 100644
--- a/HostLibraryTests/CMakeLists.txt
+++ b/HostLibraryTests/CMakeLists.txt
@@ -105,7 +105,6 @@ add_subdirectory(testlib)
 
