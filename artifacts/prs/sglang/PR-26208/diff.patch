+    if total_topk >= 8192:
+        # Adaptive split_k selection for optimal performance
+        # split_k=3 is optimal for topk >= 16384 based on benchmarking
+        if total_topk >= 16384:
+            split_k = 3
+        else:
+            split_k = 2
+        output, lse = run_splitk_unified_attention(
+            q_reshaped,
+            gathered_kv,
+            invalid_mask,
+            d_v,
+            sm_scale,
+            total_tokens,
+            h_q,
+            total_topk,
+            d_qk,
+            attn_sink=attn_sink,
+            split_k=split_k,
+        )
+    elif total_topk <= 65536:
+        output, lse = run_unified_attention(
+            q_reshaped,
+            gathered_kv,
+            invalid_mask,
+            d_v,
+            sm_scale,
+            total_tokens,
+            h_q,
+            total_topk,
+            d_qk,
+            attn_sink=attn_sink,
+        )
+    else:
