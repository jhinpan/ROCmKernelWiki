+def _fused_gather_attn_dsv4_splitk_kernel(
+    Q,
+    KV_Cache,
+    Indices,
+    TopkLength,
+    PartialOutput,
+    PartialLSE,
+    sm_scale,
+    total_tokens,
+    total_tokens_bucket,
+    h_q,
+    topk,
+    num_blocks,
