+              specifies the form of op( A ).
+    @param[in]
+    transB    rocblas_operation.
+              specifies the form of op( B ).
+    @param[in]
+    m         rocblas_int.
+              matrix dimension m.
+    @param[in]
+    n         rocblas_int.
