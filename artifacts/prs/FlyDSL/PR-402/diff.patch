+        d_output_off_s1 = _ds1["d_output_off"]
+        _lds_d_stride_elems_s1 = _ds1["lds_d_stride_elems"]
+        _warp_d_elems_s1 = _ds1["warp_d_elems"]
+        _n_col_d_elems_s1 = _ds1["n_col_d_elems"]
