+def bench_dtype_bpe(in_dtype):
+    """Return (a_bpe, w_bpe, w_scale_bpg) for bandwidth accounting."""
+    if in_dtype == "fp4":
+        return 0.5, 0.5, 1
+    if in_dtype == "a8w4":
+        return 1, 0.5, 1
+    if in_dtype == "fp8":
+        return 1, 1, 1
+    if in_dtype in ("fp16", "bf16"):
+        return 2, 2, 0
+    return 1, 1, 1
