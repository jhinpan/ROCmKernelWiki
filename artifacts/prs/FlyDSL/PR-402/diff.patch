+        TDM_PER_STEP = _pp["TDM_PER_STEP"]
+        _fence_outstanding = _pp["fence_outstanding"]
+        _tail_plan = _pp["tail_plan"]
+    from kernels.gemm_common_gfx1250 import workgroup_barrier
+
+    alloc = SmemAllocator(
+        None,
+        arch=str(get_hip_arch()),
