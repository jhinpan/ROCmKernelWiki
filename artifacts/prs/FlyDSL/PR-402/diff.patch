+            def _a_streaming_compute(
+                acg,
+                acu,
+                buf_idx,
+                b_g,
+                bs_gv,
+                b_u,
+                bs_uv,
+                as_v,
+                ks,
+                next_bs_info=None,
+                mid_compute_callback=None,
+            ):
+                next_result = None
+                a_frags_front = [
+                    load_data_frag(lds_ag_bufs[buf_idx], a_data_bases[wm], ks)
+                    for wm in range_constexpr(_front_wm)
+                ]
+                _use_partial_drain = (
+                    next_bs_info is not None
+                    and _front_wm * wmma_n_rep >= 4
+                )
