+                    idx = rocir.const_index(lin)
+                    coords = (idx,)
+                    a_val = frgA[coords]
+                    b_val = frgB[coords]
+                    c_val = a_val + b_val
+                    frgC[coords] = c_val
+
+            rocir.copy(tiled_copy_C, frgC, thrC, pred=frgPred)
+
