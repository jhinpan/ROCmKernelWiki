+@functools.lru_cache(maxsize=1024)
+def compile_hgemm_kernel(
+    dtype: str,
+    n: int,
+    k: int,
+    TILE_M: int = 128,
+    TILE_N: int = 128,
+    TILE_K: int = 64,
