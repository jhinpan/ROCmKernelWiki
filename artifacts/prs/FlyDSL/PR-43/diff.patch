diff --git a/.github/workflows/flydsl.yaml b/.github/workflows/flydsl.yaml
index 0a03e93cd..910e1e28f 100644
--- a/.github/workflows/flydsl.yaml
+++ b/.github/workflows/flydsl.yaml
@@ -79,7 +79,7 @@ jobs:
         run: |
