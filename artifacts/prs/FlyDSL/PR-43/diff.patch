+echo "Failed: ${FAIL_COUNT}"
+echo "Logs: ${BENCH_LOG_DIR}"
+echo ""
+
+if [ $FAIL_COUNT -eq 0 ]; then
+  echo "All benchmarks passed! "
+  exit 0
+else
+  echo "Some benchmarks failed. Check the output above for details."
+  exit 1
+fi
