+    PACK_B = 2 if (is_fp4 or is_a8w4) else 1
+
+    _dtype_map = {"f32": torch.float32, "bf16": torch.bfloat16, "f16": torch.float16}
+    torch_out_dtype = _dtype_map[args.out_dtype]
