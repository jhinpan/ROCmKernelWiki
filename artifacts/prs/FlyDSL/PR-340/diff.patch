+
+    tile_m, tile_n, tile_k = args.tile_m, args.tile_n, args.tile_k
+    fmt_name = "A8W4" if is_a8w4 else ("MXFP4" if is_fp4 else "MXFP8")
+
+    print("=" * 72)
+    print(f"  {fmt_name} GEMM Benchmark on gfx1250")
