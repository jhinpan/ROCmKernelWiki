+            f"tile_k_bytes must be divisible by 64, got tile_k_bytes={tile_k_bytes} "
+            f"(tile_k={tile_k}, elem_bytes={a_elem_bytes})"
+        )
+
+    out_s = str(out_dtype).strip().lower()
