+                    row_w = expert_off_idx + global_n
+                    coord_n = flir.idx2crd(row_w, layout_n_blk_intra)
+                    n_blk_list.append(flir.get(coord_n, 0))
+                    n_intra_list.append(flir.get(coord_n, 1))
+    
+                m_repeat = tile_m // 16
