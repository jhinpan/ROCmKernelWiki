+    max_diff_exp_sums = diff_exp_sums.max().item()
+    mean_diff_exp_sums = diff_exp_sums.mean().item()
+    print(f"Max difference: {max_diff_exp_sums:.6e}")
+    print(f"Mean difference: {mean_diff_exp_sums:.6e}")
+
