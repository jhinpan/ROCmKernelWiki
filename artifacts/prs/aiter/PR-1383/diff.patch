+        aiter.dtypes.bf16,
+        aiter.dtypes.fp16,
+    ], f"query tensor only support dtype in [{aiter.dtypes.fp8, aiter.dtypes.bf16, aiter.dtypes.fp16}], but got query.dtype == {query.dtype}"
