+            max_logits,
+            temporary_output,
+            query,
+            key_cache,
+            value_cache,
+            block_tables,
+            context_lengths,
+            softmax_scale,
+            query_scale,
+            key_scale,
+            value_scale,
+            compute_type,
+            query_seq_len,
+            query_group_size,
+            head_size,
+            kv_block_size,
+            context_partition_size,
+            query_quant_mode,
+            kv_quant_mode,
+            fp8_max_value,
+            value_transposed,
+            is_causal,
+        )
