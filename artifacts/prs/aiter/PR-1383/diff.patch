+            if trans_v:
+                # Shuffled layout: [num_blocks, num_kv_heads, block_size // x, head_size, x]
+                quant_elements_per_vector = 16 // aiter.dtypes.fp8.itemsize
+                quantized_values_shape = (
+                    total_blocks,
+                    num_kv_heads,
