+        aiter.dtypes.fp8,
+        aiter.dtypes.bf16,
+        aiter.dtypes.fp16,
+    ], f"key_cache tensor only support dtype in [{aiter.dtypes.fp8, aiter.dtypes.bf16, aiter.dtypes.fp16}], but got key_cache.dtype == {key_cache.dtype}"
