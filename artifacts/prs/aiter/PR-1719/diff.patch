+                       a.batch_stride_randval,
+                       a.batch_stride_lse,
+                       a.batch_stride_o,
+                       a.window_size_left,
+                       a.window_size_right,
+                       a.sink_size,
+                       a.mask_type,
+                       a.min_seqlen_q,
+                       a.p_drop,
+                       a.s_randval,
+                       a.drop_seed_offset};
+
+    return fmha_fwd(traits, args, s);
+}
+#endif
+
+float mha_fwd(mha_fwd_args args, const ck_tile::stream_config& s)
+{
+    float ret = -1;
+
+#if FAV3_ON
+    ret = fmha_fwd_v3(args, s);
+#endif
+
+#if FAV2_ON
+    if(ret == -1 && !args.v3_api_check)
