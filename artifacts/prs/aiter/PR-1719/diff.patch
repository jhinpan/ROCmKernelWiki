-
-def write_blobs(output_dir: Optional[str]) -> None:
-    if output_dir is None:
-        output_dir = Path(__file__).parent
-    else:
-        output_dir = Path(output_dir) / GEN_DIR
-
-    FMHA_HSACO_DATA = []
-
-    for hsaco_path in glob.glob(f"{Path(__file__).parent}/*.co"):
