+        }
+        else
+        {
+            TORCH_CHECK(false, __func__, "No valid kernel selected!");
+        }
+    }
+    else
+    {
+        TORCH_CHECK(false, __func__, " Input only supput Fp8!");
+    }
+
+    impl_ptr->launch_kernel<uint8_t, uint16_t>(out,
