+    if (!inter_states_ptr || !w1_ptr || !w2_ptr || !sorted_token_ids_ptr || !sorted_expert_ids_ptr || !num_valid_ids_ptr || !out_ptr)
+    {
+        std::cerr << "detect null ptr !" << std::endl;
+        return;
