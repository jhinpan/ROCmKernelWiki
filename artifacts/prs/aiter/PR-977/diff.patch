+  // // If we found an optimal kernel, use it.
+  // if (it != lookup.end())
+  // {
+  //   return it->second;
+  // }
+  // Otherwise, use heuristics.
+  if (stage == 1){
+    return moe_gemm1_heuristic_dispatch<ADataType, BDataType, AccDataType, CDataType>(M, N, K, block_m);
+  }
+  else{
