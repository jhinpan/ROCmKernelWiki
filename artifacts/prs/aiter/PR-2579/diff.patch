+    config = get_sage_fwd_configs()
+    BLOCK_M, BLOCK_N = config["BLOCK_M"], config["BLOCK_N"]
+    num_q_blocks = (N_CTX_Q + BLOCK_M - 1) // BLOCK_M
+    num_kv_blocks = (N_CTX_K + BLOCK_N - 1) // BLOCK_N
