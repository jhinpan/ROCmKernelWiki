+                BATCH,
+                HQ,
+                N_CTX_Q,
+                N_CTX_K,
+                D_HEAD,
+                D_HEAD_V,
+                args.block_sparsity,
+                n_rep,
+                median_tflops,
+                q1_tflops,
+                q3_tflops,
+                p10_tflops,
+                p90_tflops,
+                median_latency_ms,
+                q1_latency_ms,
+                q3_latency_ms,
+                p10_latency_ms,
+                p90_latency_ms,
+                median_effective_tflops,
+                q1_effective_tflops,
+                q3_effective_tflops,
+                p10_effective_tflops,
+                p90_effective_tflops,
+            ]
+            if not file_exists:
+                writer.writerow(
+                    [
+                        "BATCH",
+                        "HQ",
+                        "N_CTX_Q",
+                        "N_CTX_K",
+                        "D_HEAD",
+                        "D_HEAD_V",
+                        "block_sparsity",
+                        "n_repetitions",
+                        "median_TFLOPS",
+                        "q1_TFLOPS",
+                        "q3_TFLOPS",
+                        "p10_TFLOPS",
+                        "p90_TFLOPS",
+                        "median_latency_ms",
+                        "q1_latency_ms",
+                        "q3_latency_ms",
+                        "p10_latency_ms",
+                        "p90_latency_ms",
+                        "median_effective_TFLOPS",
+                        "q1_effective_TFLOPS",
+                        "q3_effective_TFLOPS",
+                        "p10_effective_TFLOPS",
+                        "p90_effective_TFLOPS",
+                    ]
+                )
+            writer.writerow(row)
+        logger.info(f"Wrote CSV row to {csv_path}")
