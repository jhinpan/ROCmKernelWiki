+            f.write("\n".join(mismatch_shapes) + "\n\n")
+        if output_lines:
+            repro = _extract_repro_and_reasons(output_lines)
+            if repro:
+                f.write(repro + "\n")
+
+    parts = []
+    if error_shapes:
