+def mp_lock(
+    lockPath: str,
+    MainFunc: callable,
+    FinalFunc: callable = None,
+    WaitFunc: callable = None,
+):
+    """
+    Using FileBaton for multiprocessing.
+    """
+    baton = FileBaton(lockPath)
+    if baton.try_acquire():
+        try:
+            ret = MainFunc()
+        finally:
+            if FinalFunc is not None:
+                FinalFunc()
+            baton.release()
+    else:
+        baton.wait()
+        if WaitFunc is not None:
+            ret = WaitFunc()
+        ret = None
+    return ret
+
