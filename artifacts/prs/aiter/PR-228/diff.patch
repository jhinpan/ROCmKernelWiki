-        dynamic_quant = triton.autotune(configs=_dynamic_quant_configs, key=['N'])(_triton_dynamic_quantize_kernel)
-    else:
-        dynamic_quant = _triton_dynamic_quantize_kernel
-    dynamic_quant[grid](*kwargs,**const_kwargs)
