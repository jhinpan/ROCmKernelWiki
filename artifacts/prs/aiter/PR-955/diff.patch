+        type=int,
+        default=torch.cuda.device_count(),
+        help="Tuning on multiple GPUs using multiple processes",
+    )
+
+    parser.add_argument(
+        "-o",
+        "--tune_file",
+        default="aiter/configs/a8w8_blockscale_bpreshuffle_tuned_gemm.csv",
