+KERNEL_DICT: dict[str, Callable[[list[str]], None]] = {
+    "gemm_a16w16": bench_gemm_a16w16_main,
+    "gemm_a8w8_per_token_scale": bench_gemm_a8w8_per_token_scale_main,
