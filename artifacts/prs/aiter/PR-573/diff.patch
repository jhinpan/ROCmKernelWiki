+
+        grid_reduce = (
+            Batch,
+            triton.cdiv(M, REDUCE_BLOCK_SIZE_M),
+            triton.cdiv(N, REDUCE_BLOCK_SIZE_N),
+        )
+        _batched_gemm_afp4_wfp4_pre_quant_reduce_kernel[grid_reduce](
+            y_pp,
+            y,
+            M,
+            N,
+            y_pp.stride(0),
+            y_pp.stride(1),
+            y_pp.stride(2),
+            y_pp.stride(3),
+            y.stride(0),
+            y.stride(1),
+            y.stride(2),
+            REDUCE_BLOCK_SIZE_M,
+            REDUCE_BLOCK_SIZE_N,
+            ACTUAL_KSPLIT,
+            config["NUM_KSPLIT"],
+        )
