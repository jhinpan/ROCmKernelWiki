+        nargs=4,
+        metavar=("batch", "M", "N", "K"),
+        help="user-defined shape to benchmark",
+    )
+    parser.add_argument(
+        "--metric",
+        type=str,
+        choices=["time", "throughput", "bandwidth"],
+        default="throughput",
+        help="metric to plot",
+    )
+    args = parser.parse_args()
+    return args
+
+
+def main():
+    args = parse_args()
+    run_benchmark(args)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
