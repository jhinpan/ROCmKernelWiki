+
+    a = torch.randn((M, K), dtype=dtype, device="cuda")
+    w1 = torch.rand((E, N, K), dtype=dtype, device="cuda")
+    w2 = torch.rand((E, K, N // 2), dtype=dtype, device="cuda")
