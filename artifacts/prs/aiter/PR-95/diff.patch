+                        std::optional<void *> w1_scale, // [e, 1, n], gate(up) scale
+                        std::optional<void *> a1_scale  // [m, 1], token scale
+)
+{
+    // ~~~~~~~~~~~~~~~~~~~~~~~~following start with ck things
+    ck::index_t StrideA = K;
+    ck::index_t StrideB = K;
+    ck::index_t StrideD = 0;
