-    tl.store(qk_descale_ptr, qk_descale, mask=(offs_m[:, None] < seqlen))
-
-    tl.store(
-        qk_quant_ptr,
-        qk_quant_tile,
-        mask=(offs_m[:, None] < seqlen),
-    )
