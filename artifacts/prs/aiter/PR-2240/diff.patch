-        K_descale,
-        R,
-        sm_scale,
-        stride_qb,
-        stride_qh,
-        stride_qm,
-        stride_qd,
-        stride_qqb,
-        stride_qqm,
-        stride_qqh,
-        stride_qqd,
-        stride_qsb,
