+
+    bshd = [0, 1, 2, 3] if layout == "bshd" else [0, 2, 1, 3]
+
+    # shapes
+    b, s_q, h_q, d = map_dims(q.shape, bshd)
+    _, s_k, h_k, _ = map_dims(k.shape, bshd)
