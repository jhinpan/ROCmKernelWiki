-        r_mat = tl.load(r_ptr)  # BLOCK_R x BLOCK_R
-
-        shape0: tl.constexpr = BLOCK_M * D // BLOCK_R
-
-        # Rotate: Q_rot = Q @ R
-        qk_rot_tile = tl.dot(qk_tile.reshape((shape0, BLOCK_R)).to(r_mat.dtype), r_mat)
