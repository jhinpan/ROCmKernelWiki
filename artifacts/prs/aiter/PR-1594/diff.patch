+    base_in = mixed_qkvz + i_seq * QKVZ_DIM_T
+    base_out = mixed_qkv + i_seq * QKV_DIM_T
+
+    # Load and store q
+    blk_q = tl.load(base_in + tl.arange(0, HEAD_QK))
+    tl.store(base_out + tl.arange(0, HEAD_QK), blk_q)
