+        + (idx_feats * stride_conv_state_dim)
+    )
+    mask_w = idx_feats < dim
+
+    prior_tokens = conv_states_base
+    conv_state_vecs = ()
+    for j in gl.static_range(KERNEL_WIDTH - 1):
