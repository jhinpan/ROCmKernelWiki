+@triton.jit
+def _fused_qkvzba_prefill_kernel_nqk2(
+    mixed_qkv,
+    z,
+    b_out,
+    a_out,
+    mixed_qkvz,
+    mixed_ba,
+    NUM_HEADS_V: tl.constexpr,
+    HEAD_QK: tl.constexpr,
+    HEAD_V: tl.constexpr,
