+        g,
+        k,
+        beta,
+        g_cumsum,
+        A,
+        cu_seqlens,
+        chunk_indices,
+        T,
+        H,
+        Hg,
+        K,
+        chunk_size,
+        num_warps=4,
+        num_stages=3,
+    )
+    return g_cumsum, A
