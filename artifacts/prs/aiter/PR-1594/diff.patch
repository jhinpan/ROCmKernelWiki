+@gluon.jit()
+def gluon_causal_conv1d_update_split_qkv_kernel(
+    # Pointers to matrices
+    x_ptr,  # (batch, dim, seqlen) where dim = 2*key_dim + value_dim
+    w_ptr,  # (dim, width)
+    bias_ptr,
+    conv_state_ptr,
