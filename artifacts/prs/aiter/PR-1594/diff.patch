+    # Load and store b, a
+    base_ba = mixed_ba + i_seq * BA_DIM_T
+    for i in tl.static_range(V_PER_QK):
+        tl.store(b_out + i_seq * NUM_HEADS_V + i, tl.load(base_ba + i))
+        tl.store(a_out + i_seq * NUM_HEADS_V + i, tl.load(base_ba + V_PER_QK + i))
