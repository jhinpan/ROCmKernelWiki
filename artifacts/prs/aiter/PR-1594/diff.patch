+    w_base = w_ptr + (idx_feats * stride_w_dim)
+    mask_w = idx_feats < dim
+    w_vecs = ()
+    for j in gl.static_range(KERNEL_WIDTH):
+        w_ptrs = w_base + (j * stride_w_width)
+        w_col = gl.load(w_ptrs, mask_w, other=0.0)
