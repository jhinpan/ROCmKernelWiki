+                b_out + i_seq * NUM_HEADS_V + i_qk * V_PER_QK + i, tl.load(base_ba + i)
+            )
+            tl.store(
+                a_out + i_seq * NUM_HEADS_V + i_qk * V_PER_QK + i,
+                tl.load(base_ba + V_PER_QK + i),
+            )
