+
+    V_PER_QK: tl.constexpr = NUM_HEADS_V // NUM_HEADS_QK
+    QKVZ_DIM_T: tl.constexpr = HEAD_QK * 2 + V_PER_QK * HEAD_V * 2
+    BA_DIM_T: tl.constexpr = V_PER_QK * 2
+    QKV_DIM_T: tl.constexpr = NUM_HEADS_QK * HEAD_QK * 2 + NUM_HEADS_V * HEAD_V
