+
+        for j in gl.static_range(KERNEL_WIDTH):
+            matrix_w = w_vecs[j]
+            matrix_x = conv_state_vecs[j]
+            acc += matrix_x * matrix_w
+
+        conv_state_vecs = conv_state_vecs[1:]
+
