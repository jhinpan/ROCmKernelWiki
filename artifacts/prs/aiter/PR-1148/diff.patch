+    sin = tl.load(sin_ptr + cos_offs, mask=cos_mask)
+
+    nope_offs = 0
+    if HAVE_NOPE and NOPE_FIRST:
+        nope_offs = BLOCK_D
+
+    offs_nope_ratio = 1
+    if HAVE_NOPE:
+        offs_nope_ratio = 2
+
+    x_mask = t_mask[:, None] & (d_offs < BLOCK_D)[None, :]
+
+    if IS_NEOX:
+        qk_rotated_mask = (d_offs < BLOCK_D_HALF)[None, :]
+    else:
+        qk_rotated_mask = (d_offs % 2 == 0)[None, :]
