+                b_fp8_ptrs += BLOCK_SIZE_K * stride_b_fp8_k
+                a_scale_ptrs += offs_ks_step * stride_a_fp8_scale_k
+                b_scale_ptrs += offs_ks_step * stride_b_fp8_scale_k
