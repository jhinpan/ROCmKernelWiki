+            b_ptrs = b_bf16_ptr + (
+                offs_k_split[:, None] * stride_b_bf16_k
+                + offs_b_bf16_n[None, :] * stride_b_bf16_n
+            )
+
+            if ADD_BIAS_BF16:
+                if NUM_KSPLIT == 1 or (SKIP_REDUCE and pid_k == 0):
+                    accumulator_bf16 = tl.load(bias_bf16_ptr + offs_b_bf16_n).to(
