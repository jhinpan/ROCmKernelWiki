+                    )
+                    accumulator_bf16 = tl.broadcast_to(
+                        accumulator_bf16[None, :], (BLOCK_SIZE_M, BLOCK_SIZE_N)
+                    )
+                else:
+                    accumulator_bf16 = tl.zeros(
+                        (BLOCK_SIZE_M, BLOCK_SIZE_N), dtype=acc_dtype
+                    )
+            else:
+                accumulator_bf16 = tl.zeros(
+                    (BLOCK_SIZE_M, BLOCK_SIZE_N), dtype=acc_dtype
+                )
+
+            for k in range(pid_k * num_k_iter, (pid_k + 1) * num_k_iter):
