+                0, BLOCK_SIZE_N
+            ).to(tl.int64)
+            c_fp8_ptrs = (
+                c_fp8_ptr
+                + stride_c_fp8_m * offs_cm[:, None]
+                + stride_c_fp8_n * offs_c_fp8_n[None, :]
+                + pid_k * stride_c_fp8_k
+            )
+            c_fp8_mask = (offs_cm[:, None] < M) & (offs_c_fp8_n[None, :] < N_fp8)
