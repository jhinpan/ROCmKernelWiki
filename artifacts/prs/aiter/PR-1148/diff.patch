+@triton.jit
+def _fused_gemm_a8w8_blockscale_a16w16_kernel(
+    # Pointers to matrices
+    a_fp8_ptr,
+    b_fp8_ptr,
+    bias_fp8_ptr,
+    a_fp8_scale_ptr,
+    b_fp8_scale_ptr,
+    c_fp8_ptr,
+    a_bf16_ptr,
+    b_bf16_ptr,
+    bias_bf16_ptr,
+    c_bf16_ptr,
+    # Matrix dimensions
+    M,
+    N_fp8,
+    N_bf16,
+    K,
+    stride_a_fp8_m,
+    stride_a_fp8_k,
+    stride_b_fp8_k,
+    stride_b_fp8_n,
+    stride_a_fp8_scale_m,
+    stride_a_fp8_scale_k,
+    stride_b_fp8_scale_k,
+    stride_b_fp8_scale_n,
+    stride_c_fp8_k,
+    stride_c_fp8_m,
+    stride_c_fp8_n,
+    stride_a_bf16_m,
+    stride_a_bf16_k,
+    stride_b_bf16_k,
+    stride_b_bf16_n,
+    stride_c_bf16_k,
+    stride_c_bf16_m,
+    stride_c_bf16_n,
+    # Meta-parameters
+    GROUP_K: tl.constexpr,
+    GROUP_N: tl.constexpr,
+    BLOCK_SIZE_M: tl.constexpr,
+    BLOCK_SIZE_N: tl.constexpr,
+    BLOCK_SIZE_K: tl.constexpr,
+    GROUP_SIZE_M: tl.constexpr,
