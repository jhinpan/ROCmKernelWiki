+        adj_delta = (
+            batch_idx * stride_delta_b
+            + head_q_idx * stride_delta_h
+            + q_start * stride_delta_m
+        )
+        m_ptr_adj = m_ptr + adj_delta
+        delta_ptr_adj = delta_ptr + adj_delta
