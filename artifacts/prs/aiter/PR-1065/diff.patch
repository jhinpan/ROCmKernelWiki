+        dropout_offset = 0
+        if ENABLE_DROPOUT:
+            batch_philox_offset = (
+                philox_offset_base
+                + batch_idx * stride_dropout_b
+                + head_q_idx * stride_dropout_h
+            )
+            dropout_offset = (
+                dropout_mask
+                + batch_idx * stride_dropout_b
+                + head_q_idx * stride_dropout_h
+            )
+
