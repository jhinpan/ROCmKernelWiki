+        // Load Q from VRAM to GPRs.
+        q_manager.template load_q_to_gpr<k_q_nope_begin, k_q_rope_begin>(
+            params.query, warp_idx, qo_start, p_lds_q);
+        __builtin_amdgcn_sched_barrier(0);
