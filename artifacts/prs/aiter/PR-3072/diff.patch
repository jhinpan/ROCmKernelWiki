+        asm volatile("v_mul_f32_e32 v[%0], %4, v[%0]\n\t"
+                     "v_mov_b32 v[%1], %5\n\t"
+                     "v_pk_mov_b32 v[%2:%3], %6, %6 op_sel:[0, 0]"
