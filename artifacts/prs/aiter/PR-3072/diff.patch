+        // [kv_tile_start, kv_tile_start+32) and pass 1 covers rows
+        // [kv_tile_start+32, kv_tile_start+64).
+        constexpr int32_t kNumPasses = T::kBlockN / 32;
+        int32_t row_kv_ld[kNumPasses];
+#pragma unroll
+        for(int32_t p = 0; p < kNumPasses; ++p)
