+                kv_manager.template load_transposed_v_to_gpr<0, T::kBlockK, k_kv_1_begin>(
+                    p_lds_kv_curr);
+                kv_manager.template load_transposed_v_to_gpr<16, T::kBlockK, k_kv_1_begin + 2>(
+                    p_lds_kv_curr);
