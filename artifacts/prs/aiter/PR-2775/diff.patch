+                    current_stage = fx.Index(state[1])
+                    c_frags_local = state[2 : 2 + C_FRAGS_LEN]
+                    for unroll_i in range_constexpr(UNROLL):
+                        cond = arith.cmpi(
+                            arith.CmpIPredicate.ult,
+                            fx.Index(bki + unroll_i),
+                            fx.Index(BLOCK_K_LOOPS - 1),
