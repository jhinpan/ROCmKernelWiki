+                            results_=[T.vec(WMMA_C_FRAG_VALUES, T.f32)] * C_FRAGS_LEN
+                            + [T.index, T.i32],
+                            has_else=True,
+                        )
+                        with ir.InsertionPoint(cond_if.then_block):
+                            next_stage = 1 - current_stage
