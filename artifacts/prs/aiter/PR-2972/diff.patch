+template <typename DTYPE_I, typename DTYPE_O, typename IDXTYPE, typename DTYPE_B, int32_t VEC_SIZE_I>
+__global__ void swiglu_act_and_mul_bias_kernel(DTYPE_O* __restrict__ out,              // [..., d]
