+                                                auto* out_ptr = reinterpret_cast<output_dtype*>(
+                                                    out.data_ptr());
+                                                auto* in_ptr = reinterpret_cast<const input_dtype*>(
+                                                    input.data_ptr());
+                                                auto* bias_ptr =
+                                                    reinterpret_cast<const bias_dtype*>(
+                                                        bias.data_ptr());
+                                                AITER_DISPATCH_CASE_VEC_SIZE_rmTorch(
