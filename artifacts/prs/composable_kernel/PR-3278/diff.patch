+                                                             make_tuple(Number<kk / B_K1>{},
+                                                                        I0,
+                                                                        I0,
+                                                                        n0,
+                                                                        I0,
+                                                                        k0,
+                                                                        Number<kk % B_K1>{}))>{}];
+                                    });
+                                    using wmma_input_type_a =
+                                        typename vector_type<ComputeTypeA, WmmaK / A_KRow>::type;
+                                    using wmma_input_type_b =
