+struct DeviceGemmMultiD_Wmma_CShuffle_V3_BPreshuffle
+    : public DeviceGemmMultipleDSplitKBPreShuffle<ALayout,
+                                                  BLayout,
+                                                  DsLayout,
+                                                  ELayout,
