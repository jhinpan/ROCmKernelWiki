+            reduction_strategy_value = trait_config.get("reduction_strategy", {}).get(
+                "values", ["reduction"]
+            )
+
+            all_combinations = list(
+                itertools.product(
+                    pipelines,
+                    epilogues,
+                    schedulers,
+                    reduction_strategy_value,
+                    pad_m_values,
+                    pad_n_values,
+                    pad_k_values,
+                    persistent_values,
+                )
