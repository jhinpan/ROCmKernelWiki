+              StrideB{StrideB_},
+              StrideC{StrideC_},
+              Streamk_sel{Streamk_sel_},
+              Grid_size{Grid_size_},
+              MPadded{CalculateMPadded(M_)},
+              NPadded{CalculateNPadded(N_)},
+              KRead{CalculateKRead(K_, 1)},
+              KPadded{CalculateKPadded(K_, 1)},
+              AK0{CalculateAK0Padded(K_, 1)},
