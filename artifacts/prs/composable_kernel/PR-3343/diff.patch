+    case DataType::FP64: return 8;
     case DataType::INT32: return 4;
     case DataType::I8: return 1;
+    case DataType::I8_I8: return 2;
     case DataType::U8: return 1;
     }
+    return 0; // Default case to ensure all control paths return a value
 }
 
