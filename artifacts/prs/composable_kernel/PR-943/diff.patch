+                                                                                CDataType,
+                                                                                AccDataType,
+                                                                                AElementOp,
+                                                                                B1ElementOp,
+                                                                                CElementOp>;
+
+#include "run_batched_multihead_attention_bias_infer.inc"
+
+int main(int argc, char* argv[]) { return run(argc, argv); }
