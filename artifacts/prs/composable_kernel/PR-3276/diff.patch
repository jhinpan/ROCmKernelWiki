+
+TEST(ConvThreadBlock, AssignsThreadBlockAndTileSize)
+{
+    constexpr struct Algorithm
+    {
+        struct ThreadBlock
+        {
+            int block_size = 256;
+            struct TileSize
+            {
+                int m = 128;
+                int n = 128;
+                int k = 16;
+            } tile_size;
+        } thread_block;
+    } kAlgorithm;
+    constexpr ConvBlock block_info = SetThreadBlockInfo<kAlgorithm>();
+
+    EXPECT_EQ(block_info.block_size, 256);
