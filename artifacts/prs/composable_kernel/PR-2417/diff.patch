+            {"-t=1", "-e=25"},
+            {"-t=31", "-e=19", "-k=15"},
+            {"-t=81", "-e=37", "-k=7"},
+            {"-t=23", "-e=1", "-k=1"},
+            {"-t=127", "-e=99", "-k=19"},
+            {"-t=71", "-e=11", "-k=11"},
+            {"-t=1", "-e=1", "-k=1"},
