+    };
+
+    bool result      = true;
+    std::string pr_i = "-prec=" + data_type;
+    strncpy(bufs[0], "add_rmsnorm2d_rdquant_fwd", 64);
+    strncpy(bufs[1], pr_i.c_str(), 64);
+    for(size_t i = 0; i < params.size(); i++)
