-                input[k * 2 + 1] = (i4x2 >> 0) & 0xf;
-            }
-
-            // permute 01234567->20643175
-            {
-                int8_t hi        = input[2];
-                int8_t lo        = input[0];
-                int8_t i4x2      = (hi << 4) | lo;
-                tensor(j + 0, i) = i4x2;
-            }
-
-            {
-                int8_t hi        = input[6];
-                int8_t lo        = input[4];
-                int8_t i4x2      = (hi << 4) | lo;
-                tensor(j + 2, i) = i4x2;
