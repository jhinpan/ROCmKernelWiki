+// clang-format on
+
+// Test suite for AQuant Base CCR
+TYPED_TEST_SUITE(TestCkTileGemmAQuant, AQuantBaseCCRTypes);
+
+// AQuant tests
+TYPED_TEST(TestCkTileGemmAQuant, AQuantGroupedTest)
+{
+    this->run_test_with_validation(1024, 1024, 1024);
+}
