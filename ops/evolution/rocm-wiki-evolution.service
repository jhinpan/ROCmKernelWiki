[Unit]
Description=ROCmKernelWiki daily evidence discovery and Draft PR update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rocmwiki
Group=rocmwiki
WorkingDirectory=/sgl-workspace/ROCmKernelWiki
EnvironmentFile=-/etc/rocm-kernel-wiki/evolution.env
ExecStart=/usr/bin/python3 scripts/evolve/daily_worker.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
LockPersonality=true
RestrictSUIDSGID=true
UMask=0077
TimeoutStartSec=2h
