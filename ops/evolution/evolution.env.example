# Short-lived GitHub App installation token: contents/pull-requests write,
# metadata read. The bot may update only bot/evolution and Draft PRs.
GH_TOKEN=

# Required only until the first refresh PR persists per-source watermarks.
ROCM_WIKI_INITIAL_SINCE=2026-05-30T00:00:00Z
ROCM_WIKI_BOOTSTRAP_TREES=1

# Optional bounded synthesis adapter. It receives candidate JSON on stdin and
# returns the schema documented by scripts/evolve/synthesize.py.
ROCM_WIKI_AGENT_COMMAND=

WIKI_BOT_NAME=rocmkernelwiki-evolution[bot]
WIKI_BOT_EMAIL=rocmkernelwiki-evolution[bot]@users.noreply.github.com
