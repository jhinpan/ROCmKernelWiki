[Unit]
Description=ROCmKernelWiki trusted MI355 evidence worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rocmwiki
Group=rocmwiki
SupplementaryGroups=video render
WorkingDirectory=/sgl-workspace/ROCmKernelWiki
EnvironmentFile=-/etc/rocm-kernel-wiki/mi355.env
ExecStart=/usr/bin/python3 scripts/evolve/mi355_worker.py --once
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=false
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/sgl-workspace/ROCmKernelWiki/.git
ReadWritePaths=/sgl-workspace/ROCmKernelWiki/.evidence
ReadWritePaths=/tmp
LockPersonality=true
RestrictSUIDSGID=true
UMask=0077
TimeoutStartSec=45min
