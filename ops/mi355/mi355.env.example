# GitHub App installation token with read PR/content and write checks only.
GH_TOKEN=

# Immutable ROCm image. Tags such as :latest are rejected.
ROCM_WIKI_MI355_IMAGE=rocm/dev-ubuntu-24.04@sha256:REPLACE_ME

# Optional: expose one render node instead of all /dev/dri nodes.
ROCM_WIKI_DRI_DEVICE=/dev/dri/renderD128

# Optional read-only pre/post health command. {gpu} is substituted by the worker.
ROCM_WIKI_MI355_HEALTH_COMMAND=amd-smi metric --gpu {gpu} --json

# Public or internal content-addressed location where the node publishes the
# full immutable run bundle. Compact verdict metadata is posted as a check run.
ROCM_WIKI_MI355_ARTIFACT_URI=
